# ============================================================
# ADD THESE to your existing apps/api/.env (and .env.example)
# ============================================================

# Public URL of the frontend — used to build verification/magic-link URLs
APP_URL="http://localhost:3000"

# Email delivery: "console" (default, logs emails to server console — zero
# setup, great for dev) or "smtp" (real delivery via nodemailer)
EMAIL_PROVIDER="console"

# Only required if EMAIL_PROVIDER=smtp — any standard SMTP provider works
# (SendGrid, Postmark, Mailgun, Gmail app password, etc.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Messenger <no-reply@yourdomain.com>"

# STUN server for video calls (Google's public STUN, free, no account needed)
STUN_URLS="stun:stun.l.google.com:19302"
